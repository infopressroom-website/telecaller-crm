# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/telecaller_crm?schema=public"

# --- App ---
NODE_ENV="development"
APP_URL="http://localhost:3000"

# --- Auth (used from Phase 03). Generate with: openssl rand -base64 32 ---
AUTH_SECRET="replace-with-a-long-random-string-min-32-chars"

# --- Development seed only. Seeding is refused when NODE_ENV=production. ---
SEED_DEV_PASSWORD="ChangeMe-Dev-Only-123"

# --- Later phases (leave empty until credentials exist; do not fake them) ---
# Optional: Redis for caching (improves dashboard and report performance). Falls back to in-memory cache if not configured.
REDIS_URL=""
TELEPHONY_PROVIDER=""
EXOTEL_ACCOUNT_SID=""
EXOTEL_API_KEY=""
EXOTEL_API_TOKEN=""
EXOTEL_WEBHOOK_SECRET=""
STORAGE_BUCKET=""

# Webhook path secret: a long random string (openssl rand -hex 24). Give Exotel the URL
#   {APP_URL}/api/webhooks/telephony/exotel/<this value>
# Must be at least 24 characters or webhooks are refused.

# --- Scheduler (automation rules, missed follow-ups). 24+ random characters. ---
# Call every minute:  curl -fsS -X POST -H "Authorization: Bearer $CRON_SECRET" $APP_URL/api/cron/automation
CRON_SECRET=""

# --- Optional AI assistant (QA transcript summaries). Off until enabled in Settings -> AI. ---
ANTHROPIC_API_KEY=""
AI_MODEL=""

# --- Optional: Pusher (Real-time notifications). Sign up at pusher.com. If not configured, app works normally without real-time updates. ---
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER=""
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER=""

# --- WhatsApp Integration (Meta Business API) ---
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_VERIFY_TOKEN=""

# --- Logging: debug | info | warn | error ---
LOG_LEVEL="info"
