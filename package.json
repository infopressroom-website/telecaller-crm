{
  "name": "telecaller-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "verify": "prisma generate && tsc --noEmit && next lint && vitest run && next build",
    "test:all": "vitest run && vitest run --config vitest.integration.config.ts",
    "db:bootstrap": "tsx prisma/bootstrap.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.3.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^4.7.0",
    "bcryptjs": "^3.0.3",
    "clsx": "2.1.1",
    "exceljs": "^3.4.0",
    "ioredis": "^6.0.0",
    "lru-cache": "^11.5.3",
    "lucide-react": "^1.76.0",
    "next": "^16.4.6",
    "papaparse": "^5.7.1",
    "pdf-lib": "1.17.1",
    "pg": "^8.23.1",
    "pusher": "^5.3.4",
    "pusher-js": "^8.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.11.0",
    "resend": "^6.38.1",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^8.0.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitest/ui": "^5.1.1",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "happy-dom": "^21.0.4",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "prisma": "^5.22.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
